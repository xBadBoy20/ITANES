<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/itanes_background"
    tools:context=".ui.detail.PlaceDetailActivity">

    <!-- AppBar & CollapsingToolbar for Hero Image -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/itanes_primary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Hero Image -->
            <ImageView
                android:id="@+id/imageDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <!-- Dark Gradient at the bottom of the image -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_splash_gradient"
                android:alpha="0.7"
                app:layout_collapseMode="pin" />

            <!-- Top Floating Bar (Back and Share) -->
            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/buttonBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_logo_container"
                        android:src="@drawable/ic_castle_tower"
                        app:tint="@color/itanes_text_on_dark" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/buttonShare"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_logo_container"
                        app:icon="@drawable/ic_shield_info"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/itanes_text_on_dark" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Píldoras Flotantes de Patrimonio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_logo_container"
                    android:backgroundTint="@color/itanes_surface_low"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="✓ PATRIMONIO CULTURAL UNESCO"
                    android:textColor="@color/itanes_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_logo_container"
                    android:backgroundTint="@color/itanes_surface_low"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="★ 4.9 (1,420)"
                    android:textColor="@color/itanes_gold_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título Monumental -->
            <TextView
                android:id="@+id/textDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:textColor="@color/itanes_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Basílica y Convento de San Francisco" />

            <TextView
                android:id="@+id/textDetailShortDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jakarta_sans"
                android:text="Cercado de Lima • Fundado en 1546 • Barroco Limeño"
                android:textColor="@color/itanes_text_secondary"
                android:textSize="14sp" />

            <!-- Reproductor Audio-guía -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F0F4FA"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/itanes_surface_dim">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_logo_container"
                        android:backgroundTint="@color/itanes_primary"
                        android:src="@drawable/ic_bookmark_star"
                        app:tint="@color/itanes_text_on_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:progress="35"
                            app:indicatorColor="@color/itanes_primary"
                            app:trackColor="@color/itanes_surface_dim"
                            app:trackCornerRadius="2dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Audio-guía oficial"
                                android:textColor="@color/itanes_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="04:18"
                                android:textColor="@color/itanes_text_secondary"
                                android:textSize="12sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bloques de Información Práctica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="@drawable/bg_logo_container"
                android:backgroundTint="@color/itanes_surface"
                android:padding="16dp">

                <!-- Horario -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_compass"
                        app:tint="@color/itanes_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="HORARIO DE VISITA: Lunes a Domingo 09:00 - 20:00"
                        android:textColor="@color/itanes_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Dirección (Address dynamic) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_castle_tower"
                        app:tint="@color/itanes_primary" />
                    <TextView
                        android:id="@+id/textDetailAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="DIRECCIÓN: Jr. Lampa y Jr. Áncash s/n"
                        android:textColor="@color/itanes_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Costo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_database"
                        app:tint="@color/itanes_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="COSTO DE ENTRADA: General S/ 15.00 • Estudiantes S/ 8.00"
                        android:textColor="@color/itanes_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Coordinates dynamic -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textDetailCoordinates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="Coordenadas"
                        android:textColor="@color/itanes_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Full Description -->
            <TextView
                android:id="@+id/textDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/jakarta_sans"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/itanes_text_secondary"
                android:textSize="15sp"
                tools:text="Descripción completa del lugar histórico..." />

            <!-- Spacer and other original buttons if needed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFavorite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Favorito"
                    android:textColor="@color/itanes_primary"
                    app:strokeColor="@color/itanes_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonMap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Ver en Mapa"
                    android:textColor="@color/itanes_primary"
                    app:strokeColor="@color/itanes_primary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botón fijo en la parte inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonDirections"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/itanes_primary"
        android:text="Iniciar Recorrido hacia aquí →"
        android:textAllCaps="true"
        android:textColor="@color/itanes_text_on_dark"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_compass"
        app:iconTint="@color/itanes_gold" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>